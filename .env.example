# Database (required)
DATABASE_URL=postgres://postgres:dev@localhost:5432/cronhive

# Server
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (requests per second per tenant)
RATE_LIMIT_RPS=60

# S3 / MinIO log offload (optional — leave blank to store logs inline)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cronhive-logs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# SMTP email alerts (optional — leave blank to skip email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Webhook HMAC signing secret (optional — leave blank to skip signing)
WEBHOOK_SECRET=

# JWT (reserved for future use)
JWT_SECRET=change-me-in-production
